# Copie para .env (local) e cadastre as mesmas variáveis na Vercel.
# Supabase > Connect > Transaction pooler (porta 6543)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
ADMIN_EMAIL=email-da-cliente@exemplo.com
# npm run hash-senha -- "senha-da-cliente"
ADMIN_PASSWORD_HASH=
# Texto aleatório longo, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
